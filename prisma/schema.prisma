// The Hekim's Connect - Unani Medicine Platform
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  avatarColor   String    @default("teal")
  avatarImage   String?
  active        Boolean   @default(true)
  failedAttempts Int      @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  otpCodes     OtpCode[]
  loginEvents  AdminLoginEvent[]
  sessions     AdminSession[]
  activityLogs AdminActivityLog[]
}

model AdminLoginEvent {
  id            String   @id @default(cuid())
  adminId       String?
  adminName     String
  email         String
  ip            String?
  browser       String?
  os            String?
  device        String?
  status        String // "success" | "failed"
  failureReason String?
  sessionId     String?
  createdAt     DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
}

model AdminSession {
  id         String    @id @default(cuid())
  adminId    String
  ip         String?
  browser    String?
  os         String?
  device     String?
  loginAt    DateTime  @default(now())
  logoutAt   DateTime?
  logoutType String? // "manual" | "timeout" | "forced" | "password_change" | "other"
  createdAt  DateTime  @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model AdminActivityLog {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  description String?
  ip          String?
  createdAt   DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model Facility {
  id             String   @id @default(cuid())
  facilityName   String   @map("name")
  email          String?  @unique
  phone          String?  @unique
  password       String
  license        String?
  specialization String   @default("General Unani Practice")
  experience     Int      @default(0)
  rating         Float    @default(5.0)
  bio            String?
  avatarColor    String   @default("teal")
  verified       Boolean  @default(false)
  active         Boolean  @default(true)
  failedLoginAttempts Int @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Facility Profile Completion (onboarding wizard)
  registeredFacilityName String?
  facilityType           String?
  hfrNumber               String?  @unique
  establishmentDate       DateTime?
  alternateContactNumber  String?
  addressLine1            String?
  addressLine2            String?
  locality                String?
  city                    String?
  district                String?
  state                   String?
  country                 String?
  pincode                 String?
  latitude                Float?
  longitude               Float?
  googlePlaceId           String?
  bedCapacity             Int?
  dailyOpdCount           Int?
  dailyAdmissions         Int?
  isOperational           Boolean   @default(true)
  is24x7                  Boolean   @default(false)
  emergencyServices       Boolean   @default(false)
  ambulanceAvailable      Boolean   @default(false)
  specializations         String?
  services                String?
  profileCompleted        Boolean   @default(false)
  profileCompletedAt      DateTime?

  appointments    Appointment[]
  mizajAssessments MizajAssessment[]
  prescriptions   Prescription[]
  otpCodes        OtpCode[]
  loginEvents     LoginEvent[]
  sessions        UserSession[]
  operatingHours  FacilityOperatingHours[]
  subscriptions   FacilitySubscription[]
  staff           Staff[]
  visits          Visit[]

  @@map("Hakim")
}

model Staff {
  id                 String   @id @default(cuid())
  staffCode          String   @unique
  facilityId         String
  name               String
  photo              String?
  email              String?
  phone              String?
  // When the email/phone above was OTP-verified, for audit purposes — carried over
  // from the verified OtpCode row at creation time.
  contactVerifiedAt  DateTime?
  employeeType       String
  specialization     String?
  qualification      String?
  designation        String?
  registrationNumber String?
  experience         Int?
  role               String?
  // JSON-stringified array, same convention as Facility.specializations/services.
  responsibilities   String?
  active             Boolean  @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  facility Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  otpCodes OtpCode[]
  doctorVisits       Visit[]      @relation("VisitDoctor")
  registeredVisits   Visit[]      @relation("VisitRegisteredBy")
  recordedPayments   Payment[]
  recordedVitalSigns VitalSigns[]
}

model FacilityOperatingHours {
  id           String   @id @default(cuid())
  facilityId   String
  dayOfWeek    Int
  isOpen       Boolean  @default(true)
  openingTime  String?
  closingTime  String?
  // Optional second shift the same day (e.g. a morning + evening clinic schedule).
  openingTime2 String?
  closingTime2 String?

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, dayOfWeek])
}

model FacilitySubscription {
  id         String   @id @default(cuid())
  facilityId String
  plan       String   @default("FREE")
  startDate  DateTime @default(now())
  endDate    DateTime
  status     String   @default("ACTIVE")
  autoRenew  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model MetadataSection {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  category  String   @default("General")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options MetadataOption[]
}

model MetadataOption {
  id        String   @id @default(cuid())
  sectionId String
  label     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section MetadataSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model Patient {
  id                String   @id @default(cuid())
  // Platform-wide display code, e.g. "PT00001234" — backfilled for pre-existing
  // rows, generated at creation going forward (see scripts/backfill-patient-codes.ts).
  patientCode       String?  @unique
  name              String
  email             String?  @unique
  // Not unique: one mobile number can register multiple family members
  // (self/spouse/child/etc.) as distinct Patient rows.
  phone             String?
  password          String
  failedLoginAttempts Int @default(0)
  lockedUntil       DateTime?
  titlePrefix       String?
  // Meta: registration_for (Self/Spouse/Child/Parent/Other) — set once at creation,
  // describes this patient's relation to whoever registered them.
  registrationFor  String?
  relationship      String?
  dob               String?
  // True when the exact date of birth isn't known and `dob` holds an
  // approximate, calculated-from-age value instead of a real DOB.
  dobApprox         Boolean  @default(false)
  gender            String?
  maritalStatus     String?
  bloodGroup        String?
  address           String?
  state             String?
  city              String?
  emergencyContact  String?
  emergencyContactName   String?
  emergencyRelationship  String?
  occupation        String?
  height            String?
  weight            String?
  // Medical history
  familyHistory     String?
  medicalHistory    String?
  chronicConditions String?
  allergies         String?
  currentMedications String?
  surgicalHistory   String?
  lifestyle         String?
  mizaj             String?
  photo             String?
  avatarColor       String   @default("amber")
  verified          Boolean  @default(false)
  active            Boolean  @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  appointments     Appointment[]
  records          Record[]
  mizajAssessments MizajAssessment[]
  prescriptions    Prescription[]
  otpCodes         OtpCode[]
  loginEvents      LoginEvent[]
  sessions         UserSession[]
  visits           Visit[]
}

model Appointment {
  id        String   @id @default(cuid())
  facilityId String  @map("hakimId")
  patientId String
  date      String
  time      String
  type      String   @default("Consultation")
  reason    String?
  status    String   @default("scheduled")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facility     Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescriptions Prescription[]
}

// A single encounter: a patient physically registered at a facility on a given
// day. Distinct from Appointment (which is the patient's own advance-booking
// self-service flow) — the two aren't unified yet, see the Patient Module plan.
model Visit {
  id              String   @id @default(cuid())
  visitCode       String   @unique
  patientId       String
  facilityId      String
  doctorId        String?
  // Staff.id of whoever registered this visit; null when the acting user was
  // the Facility account itself rather than a logged-in staff member.
  registeredById  String?
  reasonForVisit  String?
  status          String   @default("registered")
  visitDate       DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility     Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  doctor       Staff?   @relation("VisitDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  registeredBy Staff?   @relation("VisitRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  payments     Payment[]
  vitalSigns   VitalSigns?
}

model Payment {
  id              String   @id @default(cuid())
  paymentCode     String   @unique
  visitId         String
  amount          Float
  mode            String
  status          String   @default("paid")
  amountReceived  Float?
  referenceNumber String?
  recordedById    String?
  createdAt       DateTime @default(now())

  visit      Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)
  recordedBy Staff? @relation(fields: [recordedById], references: [id], onDelete: SetNull)
}

// Basic vitals captured once per Visit (Phase 2 of the Patient Module — see
// the Patient Module plan). Reference ranges for soft-validation live as
// plain constants in the form component, not here; this is just the record.
model VitalSigns {
  id                 String   @id @default(cuid())
  visitId            String   @unique
  pulse              Int?
  bpSystolic         Int?
  bpDiastolic        Int?
  spo2               Int?
  spo2Context        String?
  oxygenLitres       Float?
  temperatureF       Float?
  temperatureC       Float?
  respiratoryRate    Int?
  consciousnessLevel String?
  mood               String?
  heightCm           Float?
  weightKg           Float?
  recordedById       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  visit      Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)
  recordedBy Staff? @relation(fields: [recordedById], references: [id], onDelete: SetNull)
}

// Encrypted storage for third-party integration keys (e.g. Gemini), one row per
// provider. Deliberately separate from PortalSetting, whose values are returned
// in the clear to the admin Settings UI — secrets never belong in that table.
model IntegrationConfig {
  id        String   @id @default(cuid())
  provider  String   @unique
  keyEnc    String?
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Message {
  id           String   @id @default(cuid())
  senderId     String
  senderType   String
  receiverId   String
  receiverType String
  content      String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([senderId, senderType])
  @@index([receiverId, receiverType])
}

model Record {
  id          String   @id @default(cuid())
  patientId   String
  type        String
  fileName    String
  fileData    String
  mimeType    String
  title       String
  description String?
  category    String   @default("General")
  createdAt   DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model MizajAssessment {
  id         String   @id @default(cuid())
  patientId  String
  facilityId String   @map("hakimId")
  dam        Int      @default(0)
  saffra     Int      @default(0)
  balgham    Int      @default(0)
  sauda      Int      @default(0)
  result     String
  pulse      String?
  notes      String?
  createdAt  DateTime @default(now())

  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model PharmacyItem {
  id          String   @id @default(cuid())
  name        String
  category    String   @default("General")
  form        String   @default("Powder")
  quantity    Int      @default(0)
  unit        String   @default("g")
  reorderLevel Int     @default(10)
  price       Float    @default(0)
  expiryDate  String?
  description String?
  inStock     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Prescription {
  id           String   @id @default(cuid())
  appointmentId String?
  patientId    String
  facilityId   String   @map("hakimId")
  items        String
  notes        String?
  therapyType  String   @default("Ilaj-bil-Dawa")
  createdAt    DateTime @default(now())

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility    Facility     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model SiteStat {
  id    String @id @default("visitors")
  count Int    @default(0)

  updatedAt DateTime @updatedAt
}

model PortalSetting {
  id        String   @id @default(cuid())
  category  String
  key       String
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@unique([category, key])
}

model EmailConfig {
  id          String   @id @default(cuid())
  provider    String   @default("smtp")
  smtpHost    String?
  smtpPort    Int?
  encryption  String   @default("tls")
  username    String?
  secretEnc   String?
  fromEmail   String?
  fromName    String?
  replyTo     String?
  active      Boolean  @default(false)
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  type      String
  subject   String
  body      String
  status    String   @default("active")
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model NotificationLog {
  id          String   @id @default(cuid())
  recipient   String
  templateKey String?
  subject     String?
  status      String
  event       String?
  error       String?
  createdAt   DateTime @default(now())
}

model OtpCode {
  id         String   @id @default(cuid())
  identifier String
  role      String?
  code      String
  purpose   String   @default("login")
  expiresAt DateTime
  used      Boolean  @default(false)
  verifiedAt DateTime?
  attempts  Int      @default(0)
  facilityId String? @map("hakimId")
  patientId String?
  adminId   String?
  staffId   String?
  createdAt DateTime @default(now())

  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  patient  Patient?  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admin    Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  staff    Staff?    @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model LoginEvent {
  id            String   @id @default(cuid())
  facilityId    String?
  patientId     String?
  identifier    String
  displayName   String
  ip            String?
  browser       String?
  os            String?
  device        String?
  status        String
  failureReason String?
  sessionId     String?
  createdAt     DateTime @default(now())

  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  patient  Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
}

model UserSession {
  id         String    @id @default(cuid())
  facilityId String?
  patientId  String?
  ip         String?
  browser    String?
  os         String?
  device     String?
  loginAt    DateTime  @default(now())
  logoutAt   DateTime?
  logoutType String?
  createdAt  DateTime  @default(now())

  facility Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  patient  Patient?  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Language {
  code        String   @id
  name        String
  englishName String
  direction   String   @default("ltr")
  enabled     Boolean  @default(false)
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0)
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  values       TranslationValue[]
  pageContents PageContent[]
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contents PageContent[]
}

model PageContent {
  id           String   @id @default(cuid())
  pageId       String
  languageCode String
  title        String
  subtitle     String?
  body         String
  status       String   @default("draft")
  updatedBy    String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  page     Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageCode], references: [code], onDelete: Cascade)

  @@unique([pageId, languageCode])
  @@index([languageCode, status])
}

model TranslationKey {
  id          String   @id @default(cuid())
  key         String   @unique
  group       String
  description String?
  sourceText  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  values TranslationValue[]
}

model TranslationValue {
  id           String   @id @default(cuid())
  keyId        String
  languageCode String
  text         String
  status       String   @default("draft")
  source       String   @default("manual")
  updatedBy    String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  key      TranslationKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  language Language       @relation(fields: [languageCode], references: [code], onDelete: Cascade)

  @@unique([keyId, languageCode])
  @@index([languageCode, status])
}
