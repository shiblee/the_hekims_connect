// The Hekim's Connect - Unani Medicine Platform
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  password       String
  avatarColor    String    @default("teal")
  avatarImage    String?
  active         Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  otpCodes                          OtpCode[]
  loginEvents                       AdminLoginEvent[]
  sessions                          AdminSession[]
  activityLogs                      AdminActivityLog[]
  reviewedChiefComplaintSuggestions ChiefComplaintSuggestion[]
}

model AdminLoginEvent {
  id            String   @id @default(cuid())
  adminId       String?
  adminName     String
  email         String
  ip            String?
  browser       String?
  os            String?
  device        String?
  status        String // "success" | "failed"
  failureReason String?
  sessionId     String?
  createdAt     DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
}

model AdminSession {
  id         String    @id @default(cuid())
  adminId    String
  ip         String?
  browser    String?
  os         String?
  device     String?
  loginAt    DateTime  @default(now())
  logoutAt   DateTime?
  logoutType String? // "manual" | "timeout" | "forced" | "password_change" | "other"
  createdAt  DateTime  @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model AdminActivityLog {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  description String?
  ip          String?
  createdAt   DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model Facility {
  id                  String    @id @default(cuid())
  facilityName        String    @map("name")
  email               String?   @unique
  phone               String?   @unique
  password            String
  license             String?
  specialization      String    @default("General Unani Practice")
  experience          Int       @default(0)
  rating              Float     @default(5.0)
  bio                 String?
  avatarColor         String    @default("teal")
  verified            Boolean   @default(false)
  active              Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Facility Profile Completion (onboarding wizard)
  registeredFacilityName String?
  facilityType           String?
  hfrNumber              String?   @unique
  establishmentDate      DateTime?
  alternateContactNumber String?
  addressLine1           String?
  addressLine2           String?
  locality               String?
  city                   String?
  district               String?
  state                  String?
  country                String?
  pincode                String?
  latitude               Float?
  longitude              Float?
  googlePlaceId          String?
  bedCapacity            Int?
  dailyOpdCount          Int?
  dailyAdmissions        Int?
  isOperational          Boolean   @default(true)
  is24x7                 Boolean   @default(false)
  emergencyServices      Boolean   @default(false)
  ambulanceAvailable     Boolean   @default(false)
  specializations        String?
  services               String?
  profileCompleted       Boolean   @default(false)
  profileCompletedAt     DateTime?
  /// Clinic owner's switch for guided tours / tutorials in their clinic (content itself is platform-wide).
  guidanceEnabled        Boolean   @default(true)

  appointments         Appointment[]
  mizajAssessments     MizajAssessment[]
  prescriptions        Prescription[]
  otpCodes             OtpCode[]
  loginEvents          LoginEvent[]
  sessions             UserSession[]
  operatingHours       FacilityOperatingHours[]
  subscriptions        FacilitySubscription[]
  staff                Staff[]
  staffRolePermissions StaffRolePermission[]
  fees                 FacilityFee[]
  visits               Visit[]
  patientReports       PatientReport[]

  @@map("Hakim")
}

model Staff {
  id                 String    @id @default(cuid())
  staffCode          String    @unique
  facilityId         String
  name               String
  photo              String?
  email              String?
  phone              String?
  // When the email/phone above was OTP-verified, for audit purposes — carried over
  // from the verified OtpCode row at creation time.
  contactVerifiedAt  DateTime?
  employeeType       String
  specialization     String?
  qualification      String?
  designation        String?
  registrationNumber String?
  experience         Int?
  role               String?
  // JSON-stringified array, same convention as Facility.specializations/services.
  responsibilities   String?
  // Per-person changes on top of the role's permissions (JSON arrays of permission keys).
  permissionGrants   String    @default("[]")
  permissionRevokes  String    @default("[]")
  active             Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  facility                           Facility                    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  otpCodes                           OtpCode[]
  doctorVisits                       Visit[]                     @relation("VisitDoctor")
  registeredVisits                   Visit[]                     @relation("VisitRegisteredBy")
  recordedPayments                   Payment[]
  recordedVitalSigns                 VitalSigns[]
  recordedScreenings                 L1Screening[]
  recordedClinicalAssessments        ClinicalAssessment[]
  recordedTreatmentPlans             TreatmentPlan[]
  recordedComplaintAssessments       ComplaintAssessment[]
  recordedVisitIntakes               VisitIntake[]
  recordedRedFlagScreenings          RedFlagScreening[]
  recordedAcuteSymptomAssessments    AcuteSymptomAssessment[]
  recordedAnatomicalRegionSelections AnatomicalRegionSelection[]
  recordedVisitChronologies          VisitChronology[]
  recordedAsbabAssessments           AsbabAssessment[]
  recordedTashkheesDossiers          TashkheesDossier[]
  recordedResidentClinicalNotes      ResidentClinicalNote[]
  referralsMade                      Referral[]
  amaDeclinesRecorded                AmaDecline[]
}

model FacilityOperatingHours {
  id           String  @id @default(cuid())
  facilityId   String
  dayOfWeek    Int
  isOpen       Boolean @default(true)
  openingTime  String?
  closingTime  String?
  // Optional second shift the same day (e.g. a morning + evening clinic schedule).
  openingTime2 String?
  closingTime2 String?

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, dayOfWeek])
}

model FacilitySubscription {
  id         String   @id @default(cuid())
  facilityId String
  plan       String   @default("FREE")
  startDate  DateTime @default(now())
  endDate    DateTime
  status     String   @default("ACTIVE")
  autoRenew  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model MetadataSection {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  category  String   @default("General")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options MetadataOption[]
}

model MetadataOption {
  id        String   @id @default(cuid())
  sectionId String
  label     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section MetadataSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model Patient {
  id                    String    @id @default(cuid())
  // Platform-wide display code, e.g. "PT00001234" — backfilled for pre-existing
  // rows, generated at creation going forward (see scripts/backfill-patient-codes.ts).
  patientCode           String?   @unique
  name                  String
  email                 String?   @unique
  // Not unique: one mobile number can register multiple family members
  // (self/spouse/child/etc.) as distinct Patient rows.
  phone                 String?
  password              String
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  titlePrefix           String?
  // Meta: registration_for (Self/Spouse/Child/Parent/Other) — set once at creation,
  // describes this patient's relation to whoever registered them.
  registrationFor       String?
  relationship          String?
  dob                   String?
  // True when the exact date of birth isn't known and `dob` holds an
  // approximate, calculated-from-age value instead of a real DOB.
  dobApprox             Boolean   @default(false)
  gender                String?
  maritalStatus         String?
  bloodGroup            String?
  address               String?
  state                 String?
  city                  String?
  emergencyContact      String?
  emergencyContactName  String?
  emergencyRelationship String?
  occupation            String?
  height                String?
  weight                String?
  // Medical history
  familyHistory         String?
  medicalHistory        String?
  chronicConditions     String?
  allergies             String?
  currentMedications    String?
  surgicalHistory       String?
  lifestyle             String?
  mizaj                 String?
  photo                 String?
  avatarColor           String    @default("amber")
  verified              Boolean   @default(false)
  active                Boolean   @default(true)
  lastLoginAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  appointments     Appointment[]
  records          Record[]
  clinicalReports  PatientReport[]
  mizajAssessments MizajAssessment[]
  prescriptions    Prescription[]
  otpCodes         OtpCode[]
  loginEvents      LoginEvent[]
  sessions         UserSession[]
  visits           Visit[]
}

model Appointment {
  id         String   @id @default(cuid())
  facilityId String   @map("hakimId")
  patientId  String
  date       String
  time       String
  type       String   @default("Consultation")
  reason     String?
  status     String   @default("scheduled")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  facility      Facility       @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescriptions Prescription[]
}

// A single encounter: a patient physically registered at a facility on a given
// day. Distinct from Appointment (which is the patient's own advance-booking
// self-service flow) — the two aren't unified yet, see the Patient Module plan.
model Visit {
  id             String   @id @default(cuid())
  visitCode      String   @unique
  patientId      String
  facilityId     String
  doctorId       String?
  // Staff.id of whoever registered this visit; null when the acting user was
  // the Facility account itself rather than a logged-in staff member.
  registeredById String?
  reasonForVisit String?
  status         String   @default("registered")
  visitDate      DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient                   Patient                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility                  Facility                   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  doctor                    Staff?                     @relation("VisitDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  registeredBy              Staff?                     @relation("VisitRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)
  payments                  Payment[]
  vitalSigns                VitalSigns?
  l1Screening               L1Screening?
  clinicalAssessment        ClinicalAssessment?
  treatmentPlan             TreatmentPlan?
  complaintAssessments      ComplaintAssessment[]
  humoralAssessment         HumoralAssessment?
  acuteSymptomAssessment    AcuteSymptomAssessment?
  anatomicalRegionSelection AnatomicalRegionSelection?
  chronology                VisitChronology?
  asbabAssessments          AsbabAssessment[]
  tashkheesDossier          TashkheesDossier?
  residentClinicalNote      ResidentClinicalNote?
  clinicalRoutingInsight    ClinicalRoutingInsight?
  vitalsInsightRecord       VitalsInsightRecord?
  intake                    VisitIntake?
  redFlagScreening          RedFlagScreening?
  referral                  Referral?
  amaDecline                AmaDecline?
  dalailSelection           DalailSelection?
  tashkheesSuggestion       TashkheesSuggestion?
  usoolSuggestion           UsoolSuggestion?
  ghizaSuggestion           GhizaSuggestion?
  cdsSessions               CdsSession[]
}

model Payment {
  id              String    @id @default(cuid())
  paymentCode     String    @unique
  visitId         String
  amount          Float
  mode            String
  status          String    @default("paid")
  amountReceived  Float?
  referenceNumber String?
  recordedById    String?
  createdAt       DateTime  @default(now())
  /// From the clinic fee list (snapshot of its name and amount at the time).
  feeId           String?
  feeName         String?
  standardAmount  Float?
  /// Required when the amount differs from the fee list.
  overrideReason  String?
  /// One-time key from the payment form — a repeated submit returns the same payment.
  idempotencyKey  String?
  /// Cancelled / refunded — never deleted. refundAmount may be partial.
  cancelledAt     DateTime?
  cancelledById   String?
  cancelReason    String?
  refundAmount    Float?
  refundedAt      DateTime?
  refundedById    String?
  refundReason    String?

  visit      Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)
  recordedBy Staff? @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([idempotencyKey])
}

// Basic vitals captured once per Visit (Phase 2 of the Patient Module — see
// the Patient Module plan). Reference ranges for soft-validation live as
// plain constants in the form component, not here; this is just the record.
model VitalSigns {
  id                 String   @id @default(cuid())
  visitId            String   @unique
  bpSystolic         Int?
  bpDiastolic        Int?
  heartRate          Int? // monitor/ECG-derived rate, recorded separately from manual Pulse
  pulse              Int?
  spo2               Int?
  spo2Context        String?
  temperatureF       Float?
  temperatureC       Float?
  consciousnessLevel String?
  mood               String?
  heightCm           Float?
  weightKg           Float?
  // Triage-stage notes, captured alongside vitals by the registering nurse/staff.
  painNotes          String?
  primaryFocusArea   String? // e.g. "Cervical Spine (C3-C7) & Epigastrium"
  triageRemarks      String?
  recordedById       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  visit      Visit  @relation(fields: [visitId], references: [id], onDelete: Cascade)
  recordedBy Staff? @relation(fields: [recordedById], references: [id], onDelete: SetNull)
}

// Encrypted storage for third-party integration keys (e.g. Gemini), one row per
// provider. Deliberately separate from PortalSetting, whose values are returned
// in the clear to the admin Settings UI — secrets never belong in that table.
model IntegrationConfig {
  id        String   @id @default(cuid())
  provider  String   @unique
  keyEnc    String?
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Message {
  id           String   @id @default(cuid())
  senderId     String
  senderType   String
  receiverId   String
  receiverType String
  content      String
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([senderId, senderType])
  @@index([receiverId, receiverType])
}

// Clinical reports (lab, imaging, ECG, previous prescriptions, discharge
// summaries...) added by clinic staff for a patient — distinct from Record,
// which is the patient's own portal uploads. Files live in PatientReportFile
// so listing reports never loads file bytes.
model PatientReport {
  id             String    @id @default(cuid())
  patientId      String
  facilityId     String
  category       String // see REPORT_CATEGORIES in src/lib/reports.ts
  title          String
  reportDate     DateTime?
  source         String? // lab / hospital / imaging centre
  resultFlag     String    @default("unknown") // "normal" | "abnormal" | "critical" | "unknown"
  findings       String? // key findings, typed by staff
  // Hakeem Insight reading of the files: { summary, values: [{ name, value, unit, range, flag }] }
  extraction     String?
  status         String    @default("pending_review") // "pending_review" | "reviewed"
  uploadedByType String // "facility" | "staff"
  uploadedById   String
  uploadedByName String
  reviewedByName String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  patient  Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility Facility            @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  files    PatientReportFile[]

  @@index([patientId, createdAt])
}

model PatientReportFile {
  id        String   @id @default(cuid())
  reportId  String
  fileName  String
  mimeType  String
  size      Int
  data      Bytes
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  report PatientReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------- Asbab-e-Sittah
// The six essential factors (Asbab-e-Sitta Zarooriya) — Stage 4. Pillars are
// fixed by `key` (the classical framework); admins edit wording/order/active,
// never delete. Questions and options are fully admin-managed in Meta.

model AsbabPillar {
  id          String   @id @default(cuid())
  // Which question framework this section belongs to: "asbab" (Stage 4
  // Asbab-e-Sittah) or "dalail" (Stage 5 clinical signs — Nabz, Baul, Baraz,
  // Lisan, physical inspection). Same engine, same admin, separate answers.
  framework   String   @default("asbab")
  key         String   @unique // e.g. "hawa" … "ihtibas"; "nabz", "baul", "baraz", "lisan", "zahiri"
  label       String // e.g. "Hawa-e-Muheet"
  english     String // e.g. "Ambient Air & Environment"
  description String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  questions AsbabQuestion[]
}

model AsbabQuestion {
  id               String   @id @default(cuid())
  pillarId         String
  label            String
  labelLocal       String?
  helpText         String?
  type             String // "single_select" | "multi_select" | "numeric" | "text"
  required         Boolean  @default(false)
  weight           Float    @default(1) // constitutional weight — multiplies this question's humoral points
  // Optional follow-up rule: only shown when question `showIfQuestionId` has `showIfOption` selected.
  showIfQuestionId String?
  showIfOption     String?
  sortOrder        Int      @default(0)
  active           Boolean  @default(true)
  version          Int      @default(1) // bumped when wording/options change; responses keep their own snapshot
  // --- Adaptive selection metadata (used by Stage 5 Dala'il; ignored elsewhere) ---
  // JSON { always?: boolean, complaints?: string[] (ChiefComplaint keys), symptoms?: string[]
  // (AcuteSymptomTag labels), regions?: string[] (AnatomicalRegionTag labels), sex?: "male"|"female",
  // minAge?: number, maxAge?: number }. Empty = not linked to anything (only shown on request).
  appliesTo        String   @default("{}")
  priority         Int      @default(3) // 1 (low) … 5 (high clinical value)
  safetyCritical   Boolean  @default(false) // always included when eligible, beyond the question cap
  reviewStatus     String   @default("approved") // "draft" | "approved" | "retired" — only approved questions are selected
  purpose          String? // short clinical intent, shown to the doctor as "why this question"
  reference        String? // supporting source
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pillar  AsbabPillar   @relation(fields: [pillarId], references: [id], onDelete: Cascade)
  options AsbabOption[]
}

// Which Dala'il questions were selected for a visit, how, and from which
// question-bank version — so it can always be explained later. Answers are
// stored with the Dala'il assessment as before; this only records the selection.
model DalailSelection {
  id            String   @id @default(cuid())
  visitId       String   @unique
  questionIds   String   @default("[]") // ordered, selected by the engine
  reasons       String   @default("{}") // { [questionId]: short reason }
  addedIds      String   @default("[]") // added by the doctor ("+ Add a question")
  method        String   @default("rules") // "rules" | "ranked" | "rules-fallback"
  bankVersion   String? // hash of the approved question bank used
  contextHash   String? // hash of the patient context used; a change triggers reselection
  eligibleCount Int      @default(0)
  latencyMs     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
}

// Points each option contributes to the four Akhlat (humours).
model AsbabOption {
  id          String  @id @default(cuid())
  questionId  String
  label       String
  description String?
  safra       Float   @default(0)
  dam         Float   @default(0)
  balgham     Float   @default(0)
  sauda       Float   @default(0)
  // Tashkhees engine: how strongly this finding indicates morbid matter
  // (Su-e-Mizaj Maddi rather than Sada). 0 = not an indicator.
  maddi       Float   @default(0)
  sortOrder   Int     @default(0)
  active      Boolean @default(true)

  question AsbabQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// One per visit. `status` "draft" until the doctor completes it.
model AsbabAssessment {
  id           String    @id @default(cuid())
  visitId      String
  framework    String    @default("asbab")
  status       String    @default("draft") // "draft" | "completed"
  humoral      String? // computed drift at last save: { total: {safra,dam,balgham,sauda}, pillars: {...} }
  recordedById String?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  visit      Visit           @relation(fields: [visitId], references: [id], onDelete: Cascade)
  recordedBy Staff?          @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  responses  AsbabResponse[]

  @@unique([visitId, framework])
}

// A single answer, with the question and selected options snapshotted as they
// were when answered — later admin edits never reinterpret old records.
model AsbabResponse {
  id              String  @id @default(cuid())
  assessmentId    String
  questionId      String? // live link (may be null if the question is later removed)
  pillarKey       String
  questionLabel   String
  questionType    String
  questionVersion Int
  weight          Float
  value           String // JSON: string[] of option labels for choices; number or string otherwise
  selectedOptions String  @default("[]") // JSON: [{ label, safra, dam, balgham, sauda }]

  assessment AsbabAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
}

// ---------------------------------------------------------------- Tashkhees (Stage 5)

// Admin-managed option lists for the Stage 5 dossier. `list` is one of:
// "mizaj" (temperaments), "organ" (Udw), "usool" (principles of treatment),
// "ghiza" (foods), "tadbeer" (regimens), "dosage_form", "timing", "prognosis".
model TashkheesOption {
  id           String   @id @default(cuid())
  list         String
  label        String
  localName    String?
  description  String?
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  // Tashkhees engine (organ list): which complaints / categories / symptoms /
  // body regions point to this organ — same shape as Dala'il question links.
  appliesTo    String   @default("{}")
  priority     Int      @default(3)
  // Usool-e-Ilaj principles written by the system arrive as "draft" and are
  // hidden from doctors until a physician approves them. Other lists: approved.
  reviewStatus String   @default("approved")
  // Ghiza (foods): photo, its credit/licence and source page, food group, and
  // the food's own temperament (e.g. "Barid-Ratab 1") used by the diet engine.
  imageUrl     String?
  imageCredit  String?
  imageSource  String?
  category     String?
  foodMizaj    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([list, label])
  @@index([list, sortOrder])
}

// The Hakim's diagnosis, treatment plan and handover for a visit. Option
// values are snapshotted by label (same convention as the rest of the visit).
model TashkheesDossier {
  id               String    @id @default(cuid())
  visitId          String    @unique
  status           String    @default("draft") // "draft" | "finalized"
  mizajAsli        String?
  suMizajType      String? // "Sada" | "Maddi"
  suMizajQuality   String?
  suMizajGrade     Int? // Darja 1-4
  organs           String    @default("[]")
  diagnosisNote    String?
  usool            String    @default("[]")
  usoolNote        String?
  ghizaRecommended String    @default("[]")
  ghizaAvoid       String    @default("[]")
  ghizaNote        String?
  tadbeer          String    @default("[]") // [{ label, frequency, duration, notes }]
  prognosis        String?
  followUpDate     DateTime?
  followUpNote     String?
  urgentDirectives String?
  priority         String    @default("routine") // "routine" | "priority" | "urgent"
  handoverNote     String?
  finalizedAt      DateTime?
  finalizedByName  String?
  recordedById     String?
  // Bumped on every save — a save based on an older revision is refused (two people editing at once).
  revision         Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  visit         Visit                 @relation(fields: [visitId], references: [id], onDelete: Cascade)
  recordedBy    Staff?                @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  prescriptions DossierPrescription[]
  versions      DossierVersion[]
}

// A snapshot of the dossier each time it is finalised or amended — a finalised
// record is never silently overwritten; every change keeps the one before it.
model DossierVersion {
  id        String   @id @default(cuid())
  dossierId String
  version   Int
  kind      String // "finalized" | "amended"
  reason    String? // required for amendments
  snapshot  String // JSON of the dossier as finalised
  byName    String?
  byStaffId String?
  createdAt DateTime @default(now())

  dossier TashkheesDossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@unique([dossierId, version])
}

// Ilaj-bil-Dawa lines — a table (not JSON) so pharmacy/dispensing can build
// on it later. `tagId` links the Supplements & Herbs record when chosen from it;
// the dose is always the Hakim's own entry.
model DossierPrescription {
  id           String  @id @default(cuid())
  dossierId    String
  tagId        String?
  name         String
  form         String?
  dose         String?
  timing       String?
  duration     String?
  adjuvant     String? // Badraqa / vehicle
  instructions String?
  sortOrder    Int     @default(0)

  dossier TashkheesDossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
}

model Record {
  id          String   @id @default(cuid())
  patientId   String
  type        String
  fileName    String
  fileData    String
  mimeType    String
  title       String
  description String?
  category    String   @default("General")
  createdAt   DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model MizajAssessment {
  id         String   @id @default(cuid())
  patientId  String
  facilityId String   @map("hakimId")
  dam        Int      @default(0)
  saffra     Int      @default(0)
  balgham    Int      @default(0)
  sauda      Int      @default(0)
  result     String
  pulse      String?
  notes      String?
  createdAt  DateTime @default(now())

  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model PharmacyItem {
  id           String   @id @default(cuid())
  name         String
  category     String   @default("General")
  form         String   @default("Powder")
  quantity     Int      @default(0)
  unit         String   @default("g")
  reorderLevel Int      @default(10)
  price        Float    @default(0)
  expiryDate   String?
  description  String?
  inStock      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Prescription {
